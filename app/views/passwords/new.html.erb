<% content_for :title, t("auth.forgot") %>
<%= render layout: "shared/auth_shell" do %>
  <h1><%= t("auth.forgot_title") %></h1>
  <p class="auth__lead"><%= t("auth.forgot_lead") %></p>

  <%= form_with url: passwords_path, class: "form" do |form| %>
    <div class="field">
      <%= form.label :email_address, t("auth.email"), class: "field__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "input" %>
    </div>
    <%= form.button t("auth.send_reset"), class: "btn btn--primary btn--lg btn--block" %>
  <% end %>

  <p class="auth__switch"><%= link_to t("auth.back_to_sign_in"), new_session_path %></p>
<% end %>
