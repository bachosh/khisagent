<% content_for :title, t("auth.sign_up") %>
<%= render layout: "shared/auth_shell" do %>
  <h1><%= t("auth.sign_up_title") %></h1>
  <p class="auth__lead"><%= t("auth.sign_up_lead") %></p>

  <%= form_with model: @user, url: registration_path, class: "form" do |form| %>
    <% if @user.errors.any? %>
      <div class="form-errors"><ul><% @user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
    <% end %>
    <div class="form__row">
      <div class="field">
        <%= form.label :name, t("auth.name"), class: "field__label" %>
        <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", class: "input" %>
      </div>
      <div class="field">
        <%= form.label :company, t("auth.company"), class: "field__label" %>
        <%= form.text_field :company, autocomplete: "organization", class: "input" %>
      </div>
    </div>
    <div class="field">
      <%= form.label :email_address, t("auth.email"), class: "field__label" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "input", placeholder: "name@company.ge" %>
    </div>
    <div class="form__row">
      <div class="field">
        <%= form.label :password, t("auth.password"), class: "field__label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", class: "input", minlength: 8, maxlength: 72 %>
        <span class="field__hint"><%= t("auth.password_hint") %></span>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, t("auth.password_confirmation"), class: "field__label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "input", maxlength: 72 %>
      </div>
    </div>
    <%= form.button t("auth.create_account"), class: "btn btn--primary btn--lg btn--block" %>
  <% end %>

  <p class="auth__switch"><%= t("auth.have_account") %> <%= link_to t("auth.sign_in"), new_session_path %></p>
<% end %>
